          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="live_poll_seconds" type="integer" label="32053" help="32054">
          <level>0</level>
          <default>60</default>
          <constraints><minimum>30</minimum><step>30</step><maximum>600</maximum></constraints>
          <control type="slider" format="integer"><popup>true</popup></control>
        </setting>
        <setting id="live_sync_now" type="action" label="32055" help="32056">
          <level>0</level>
          <data>RunScript(service.sudosync,livesync)</data>
          <control type="button" format="action"><close>false</close></control>
        </setting>
      </group>
      <group id="6" label="32060">
        <setting id="sudosync_id_enabled" type="boolean" label="32061" help="32062">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="sudosync_id_prefix" type="string" label="32063" help="32064">
          <level>0</level>
          <default/>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>32063</heading></control>
          <dependencies>
            <dependency type="enable">
              <condition operator="is" setting="sudosync_id_enabled">true</condition>
            </dependency>
          </dependencies>
        </setting>
        <setting id="sudosync_id_prefix_last_synced" type="string" visible="false">
          <level>0</level>
          <default/>
