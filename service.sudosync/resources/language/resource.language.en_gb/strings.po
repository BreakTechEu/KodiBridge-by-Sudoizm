msgctxt "#32000"
msgid "SudoSync"
msgstr "SudoSync"

msgctxt "#32001"
msgid "Connection"
msgstr "Connection"

msgctxt "#32002"
msgid "Synchronization folder"
msgstr "Current base path (Read-only)"

msgctxt "#32003"
msgid "SMB folder shared by all Kodi installations."
msgstr "Use the configurator button above to change this shared path."

msgctxt "#32004"
msgid "Device name"
msgstr "Device name"

msgctxt "#32005"
msgid "Optional. If empty, Kodi friendly name is used."
msgstr "Optional. If empty, Kodi friendly name is used."

msgctxt "#32006"
msgid "Snapshot interval (seconds)"
msgstr "Snapshot interval (seconds)"

msgctxt "#32007"
msgid "Collect-only mode periodically refreshes this device snapshot."
msgstr "Collect-only mode periodically refreshes this device snapshot."

msgctxt "#32008"
msgid "Show notifications"
msgstr "Show notifications for data received from another Kodi"

msgctxt "#32009"
msgid "Shows a toast notification when remote changes are applied to this Kodi library."
msgstr "Shows a toast notification when remote changes are applied to this Kodi library."

msgctxt "#32010"
msgid "Tools"
msgstr "Tools"

msgctxt "#32011"
msgid "Collect snapshot now"
msgstr "Collect snapshot now"

msgctxt "#32012"
msgid "Reads the local Kodi library and writes only this device file to NAS."
msgstr "Reads the local Kodi library and writes only this device file to NAS."

msgctxt "#32013"
msgid "Show status"
msgstr "Show status"

msgctxt "#32014"
msgid "Shows client ID, Kodi version and last local snapshot status."
msgstr "Shows client ID, Kodi version and last local snapshot status."

msgctxt "#32020"
msgid "Safety"
msgstr "Safety"

msgctxt "#32021"
msgid "Collect-only mode"
msgstr "Collect-only mode"

msgctxt "#32022"
msgid "Version 0.1 requires this option. No Kodi library data is modified."
msgstr "Version 0.1 requires this option. No Kodi library data is modified."

msgctxt "#32030"
msgid "Updates"
msgstr "Updates"

msgctxt "#32031"
msgid "Automatically check for updates on GitHub (once a day)"
msgstr "Automatically check for updates on GitHub (once a day)"

msgctxt "#32032"
msgid "Checks GitHub Releases at most once every 24 hours and asks for your consent before installing."
msgstr "Checks GitHub Releases at most once every 24 hours and asks for your consent before installing."

msgctxt "#32033"
msgid "Check for updates on GitHub now"
msgstr "Check for updates on GitHub now"

msgctxt "#32034"
msgid "Queries GitHub Releases immediately and lets you download and install a newer version with confirmation."
msgstr "Queries GitHub Releases immediately and lets you download and install a newer version with confirmation."

msgctxt "#32015"
msgid "Run DRY RUN analysis now"
msgstr "Run DRY RUN analysis now"

msgctxt "#32016"
msgid "Compares all client snapshots and writes a report. It never modifies Kodi libraries."
msgstr "Compares all client snapshots and writes a report. It never modifies Kodi libraries."

msgctxt "#32040"
msgid "Initial synchronization"
msgstr "Initial synchronization"

msgctxt "#32041"
msgid "Allow one-shot initial synchronization (modifies Kodi library)"
msgstr "Arm one-shot initial synchronization (10 min)"

msgctxt "#32042"
msgid "Safety interlock. It is switched off again after every attempt."
msgstr "Arms writes immediately without closing settings. Expires after 10 minutes and is cleared after every attempt."

msgctxt "#32043"
msgid "Apply initial synchronization to THIS Kodi"
msgstr "Apply initial synchronization to THIS Kodi"

msgctxt "#32044"
msgid "Creates a backup, rebuilds DRY RUN and applies only the safe plan to this Kodi. Background writes remain disabled."
msgstr "Creates a backup, rebuilds DRY RUN and applies only the safe initial plan. Live synchronization starts only after all Kodi clients finish initialization."

msgctxt "#32045"
msgid "This Kodi is the base device for the first synchronization"
msgstr "Set THIS Kodi as the base device for the first synchronization"

msgctxt "#32046"
msgid "Available until initialization is completed. The device must have an explicit name. Selection is stored in the shared .SudoSync configuration."
msgstr "Explicitly selects this Kodi as the base device. If another device is already selected, clear the base-device selection first."

msgctxt "#32047"
msgid "Clear base-device selection"
msgstr "Clear base-device selection"

msgctxt "#32048"
msgid "Allows choosing a different base Kodi before the first synchronization is completed."
msgstr "Clears the current selection. Only then can a different base Kodi be selected before initialization is completed."

msgctxt "#32050"
msgid "Live synchronization"
msgstr "Live synchronization"

msgctxt "#32051"
msgid "Enable live synchronization after initialization"
msgstr "Enable live synchronization after initialization"

msgctxt "#32052"
msgid "Automatically synchronizes watch state, resume and user ratings after the first synchronization is complete."
msgstr "Automatically synchronizes watched state, playcount, lastplayed, resume and user ratings after the first synchronization is complete."

msgctxt "#32053"
msgid "Peer polling interval (seconds)"
msgstr "Peer polling interval (seconds)"

msgctxt "#32054"
msgid "How often this Kodi checks other client snapshots when there is no local event."
msgstr "How often this Kodi checks other client snapshots when there is no local event."

msgctxt "#32055"
msgid "Synchronize now"
msgstr "Synchronize now"

msgctxt "#32056"
msgid "Runs one live synchronization cycle immediately and shows a final summary."
msgstr "Runs one live synchronization cycle immediately and shows a final summary."

msgctxt "#32060"
msgid "Private videos"
msgstr "Private videos"

msgctxt "#32061"
msgid "Enable SudoSync ID for local media without standard IDs"
msgstr "Enable SudoSync ID for local media without standard IDs"

msgctxt "#32062"
msgid "Allows creating a custom ID for media not present in online databases."
msgstr "Allows creating a custom ID for media not present in online databases."

msgctxt "#32063"
msgid "Network Name (SudoSync ID prefix)"
msgstr "Network Name (SudoSync ID prefix)"

msgctxt "#32064"
msgid "Friendly name for the network. The internal NFO ID is generated once and remains permanent even if you rename this."
msgstr "Friendly name for the network. The internal NFO ID is generated once and remains permanent even if you rename this."

msgctxt "#32065"
msgid "Assign SudoSync IDs to all video items in the library"
msgstr "Assign SudoSync IDs to all video items in the library"

msgctxt "#32066"
msgid "Injects SudoSync IDs to all items in Kodi library missing a standard ID."
msgstr "Injects SudoSync IDs to all items in Kodi library missing a standard ID."

msgctxt "#32070"
msgid "Select SudoSync folder / Configurator"
msgstr "Select SudoSync folder / Configurator"

msgctxt "#32071"
msgid "Click to run the SudoSync network configurator or change the shared folder."
msgstr "Click to run the SudoSync network configurator or change the shared folder."

msgctxt "#32072"
msgid "Rollback last assigned IDs"
msgstr "Rollback last assigned IDs"

msgctxt "#32073"
msgid "Restores .nfo files from .bak backups created during the last SudoSync ID assignment."
msgstr "Restores .nfo files from .bak backups created during the last SudoSync ID assignment."

msgctxt "#32074"
msgid "Install update from local ZIP file..."
msgstr "Install update from local ZIP file..."

msgctxt "#32075"
msgid "Opens a file browser so you can select a SudoSync .zip update package from a local drive or network share."
msgstr "Opens a file browser so you can select a SudoSync .zip update package from a local drive or network share."
