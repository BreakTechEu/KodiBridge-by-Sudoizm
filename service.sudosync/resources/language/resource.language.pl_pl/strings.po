msgid ""
msgstr ""
"Project-Id-Version: KodiBridge by Sudoizm\n"
"Language: pl_PL\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "#32000"
msgid "KodiBridge by Sudoizm"
msgstr "KodiBridge by Sudoizm"

msgctxt "#32001"
msgid "Connection"
msgstr "Połączenie"

msgctxt "#32002"
msgid "Synchronization folder"
msgstr "Obecna ścieżka bazowa (Tylko odczyt)"

msgctxt "#32003"
msgid "SMB folder shared by all Kodi installations."
msgstr "Użyj przycisku konfiguratora wyżej, aby zmienić tę ścieżkę współdzieloną."

msgctxt "#32004"
msgid "Device name"
msgstr "Nazwa urządzenia"

msgctxt "#32005"
msgid "Optional. If empty, Kodi friendly name is used."
msgstr "Opcjonalnie. Jeśli puste, używana jest przyjazna nazwa Kodi."

msgctxt "#32006"
msgid "Snapshot interval (seconds)"
msgstr "Interwał snapshotu (sekundy)"

msgctxt "#32007"
msgid "Collect-only mode periodically refreshes this device snapshot."
msgstr "Tryb zbierania okresowo odświeża snapshot tego urządzenia."

msgctxt "#32008"
msgid "Show notifications"
msgstr "Pokazuj powiadomienia o danych odebranych z innego Kodi"

msgctxt "#32009"
msgid "Shows a toast notification when remote changes are applied to this Kodi library."
msgstr "Wyświetla dymek powiadomienia, gdy zmiany z innego urządzenia Kodi zostaną zastosowane lokalnie."

msgctxt "#32010"
msgid "Tools"
msgstr "Narzędzia"

msgctxt "#32011"
msgid "Collect snapshot now"
msgstr "Zbierz snapshot teraz"

msgctxt "#32012"
msgid "Reads the local Kodi library and writes only this device file to NAS."
msgstr "Odczytuje lokalną bibliotekę Kodi i zapisuje na NAS tylko plik tego urządzenia."

msgctxt "#32013"
msgid "Show status"
msgstr "Pokaż status"

msgctxt "#32014"
msgid "Shows client ID, Kodi version and last local snapshot status."
msgstr "Pokazuje ID klienta, wersję Kodi i stan ostatniego snapshotu."

msgctxt "#32020"
msgid "Safety"
msgstr "Bezpieczeństwo"

msgctxt "#32021"
msgid "Collect-only mode"
msgstr "Tryb tylko zbierania"

msgctxt "#32022"
msgid "Version 0.1 requires this option. No Kodi library data is modified."
msgstr "Wersja 0.1 wymaga tej opcji. Żadne dane biblioteki Kodi nie są modyfikowane."

msgctxt "#32030"
msgid "Updates"
msgstr "Aktualizacje"

msgctxt "#32031"
msgid "Automatically check for updates on GitHub (once a day)"
msgstr "Automatycznie sprawdzaj aktualizacje na GitHub (raz na dobę)"

msgctxt "#32032"
msgid "Checks GitHub Releases once a day, at the first Kodi start of the day, and asks for your consent before installing."
msgstr "Raz dziennie, przy pierwszym uruchomieniu Kodi danego dnia, sprawdza GitHub Releases i informuje o nowej wersji z pytaniem o zgodę na instalację."

msgctxt "#32033"
msgid "Check for updates on GitHub now"
msgstr "Sprawdź dostępność aktualizacji na GitHub teraz"

msgctxt "#32034"
msgid "Queries GitHub Releases immediately and lets you download and install a newer version with confirmation."
msgstr "Odpytuje GitHub Releases natychmiast i po Twojej zgodzie pobiera oraz instaluje nową wersję."

msgctxt "#32015"
msgid "Run DRY RUN analysis now"
msgstr "Uruchom analizę DRY RUN teraz"

msgctxt "#32016"
msgid "Compares all client snapshots and writes a report. It never modifies Kodi libraries."
msgstr "Porównuje snapshoty wszystkich klientów i zapisuje raport. Nigdy nie modyfikuje bibliotek Kodi."

msgctxt "#32040"
msgid "Initial synchronization"
msgstr "Synchronizacja początkowa"

msgctxt "#32041"
msgid "Allow one-shot initial synchronization (modifies Kodi library)"
msgstr "Uzbrój jednorazową synchronizację początkową (10 min)"

msgctxt "#32042"
msgid "Safety interlock. It is switched off again after every attempt."
msgstr "Uzbraja zapis natychmiast, bez zamykania ustawień. Wygasa po 10 minutach i jest kasowany po każdej próbie."

msgctxt "#32043"
msgid "Apply initial synchronization to THIS Kodi"
msgstr "Zastosuj synchronizację początkową na TYM Kodi"

msgctxt "#32044"
msgid "Creates a backup, rebuilds DRY RUN and applies only the safe plan to this Kodi. Background writes remain disabled."
msgstr "Tworzy backup, ponawia DRY RUN i stosuje tylko bezpieczny plan początkowy. Synchronizacja bieżąca rusza dopiero po zakończeniu inicjalizacji wszystkich Kodi."

msgctxt "#32045"
msgid "This Kodi is the base device for the first synchronization"
msgstr "Ustaw TO Kodi jako urządzenie bazowe pierwszej synchronizacji"

msgctxt "#32046"
msgid "Available until initialization is completed. The device must have an explicit name. Selection is stored in the shared .KodiBridge configuration."
msgstr "Jawnie wybiera to Kodi jako bazowe. Jeżeli inne urządzenie jest już bazowe, najpierw trzeba użyć „Wyczyść wybór urządzenia bazowego”."

msgctxt "#32047"
msgid "Clear base-device selection"
msgstr "Wyczyść wybór urządzenia bazowego"

msgctxt "#32048"
msgid "Allows choosing a different base Kodi before the first synchronization is completed."
msgstr "Usuwa bieżący wybór. Dopiero po tym można wskazać inne bazowe Kodi przed zakończeniem pierwszej synchronizacji."

msgctxt "#32050"
msgid "Live synchronization"
msgstr "Synchronizacja bieżąca"

msgctxt "#32051"
msgid "Enable live synchronization after initialization"
msgstr "Włącz synchronizację bieżącą po inicjalizacji"

msgctxt "#32052"
msgid "Automatically synchronizes watch state, resume and user ratings after the first synchronization is complete."
msgstr "Po zakończeniu pierwszej synchronizacji automatycznie synchronizuje obejrzenie, playcount, lastplayed, resume i oceny użytkownika."

msgctxt "#32053"
msgid "Peer polling interval (seconds)"
msgstr "Interwał sprawdzania innych Kodi (sekundy)"

msgctxt "#32054"
msgid "How often this Kodi checks other client snapshots when there is no local event."
msgstr "Jak często to Kodi sprawdza snapshoty pozostałych urządzeń, gdy lokalnie nic się nie wydarzyło."

msgctxt "#32055"
msgid "Synchronize now"
msgstr "Synchronizuj teraz"

msgctxt "#32056"
msgid "Runs one live synchronization cycle immediately and shows a final summary."
msgstr "Natychmiast uruchamia jeden cykl synchronizacji bieżącej i pokazuje końcowe podsumowanie."

msgctxt "#32060"
msgid "Private videos"
msgstr "Prywatne wideo"

msgctxt "#32061"
msgid "Enable KodiBridge ID for local media without standard IDs"
msgstr "Włącz KodiBridge ID dla lokalnych multimediów"

msgctxt "#32062"
msgid "Allows creating a custom ID for media not present in online databases."
msgstr "Pozwala tworzyć własne ID dla wideo niewystępujących w bazach online."

msgctxt "#32063"
msgid "Network Name (KodiBridge ID prefix)"
msgstr "Nazwa sieci (prefiks KodiBridge ID)"

msgctxt "#32064"
msgid "Friendly name for the network. The internal NFO ID is generated once and remains permanent even if you rename this."
msgstr "Przyjazna nazwa. Wewnętrzny identyfikator w plikach NFO jest generowany raz i pozostanie niezmienny mimo zmiany tej nazwy."

msgctxt "#32065"
msgid "Assign KodiBridge IDs to all video items in the library"
msgstr "Przypisz KodiBridge ID wszystkim pozycjom wideo w bibliotece"

msgctxt "#32066"
msgid "Injects KodiBridge IDs to all items in Kodi library as a parallel local-network identifier."
msgstr "Zapisuje KodiBridge ID w plikach nfo (tworząc je w razie braku) dla wszystkich pozycji wideo w bibliotece jako niezależny identyfikator."

msgctxt "#32070"
msgid "Select KodiBridge folder / Configurator"
msgstr "Wybierz folder KodiBridge / Konfigurator"

msgctxt "#32071"
msgid "Click to run the KodiBridge network configurator or change the shared folder."
msgstr "Kliknij, aby uruchomić konfigurator sieciowy KodiBridge lub zmienić folder współdzielony."

msgctxt "#32072"
msgid "Rollback last assigned IDs"
msgstr "Wycofaj ostatnio przypisane ID"

msgctxt "#32073"
msgid "Restores .nfo files from the backups made by the last KodiBridge ID assignment or duplicate repair."
msgstr "Przywraca pliki .nfo z kopii zapasowych utworzonych podczas ostatniego przypisywania KodiBridge ID albo naprawy zdublowanych ID."

msgctxt "#32074"
msgid "Install update from local ZIP file..."
msgstr "Zainstaluj aktualizację ze wskazanego pliku ZIP..."

msgctxt "#32075"
msgid "Opens a file browser so you can select a KodiBridge .zip update package from a local drive or network share."
msgstr "Otwiera przeglądarkę plików, pozwalając wskazać plik aktualizacyjny .zip z dysku lokalnego lub udziału sieciowego."

msgctxt "#32076"
msgid "KodiBridge — KodiBridge ID analysis"
msgstr "KodiBridge — analiza KodiBridge ID"

msgctxt "#32077"
msgid "After closing this dialog, KodiBridge will scan your library and NFO files for KodiBridge IDs.\n\nWith a large library on NAS, this scan may take from several to over a dozen minutes.\n\nPlease do not turn off Kodi or interrupt the process until the final summary appears."
msgstr "Po zamknięciu tego komunikatu rozpocznie się analiza biblioteki i plików NFO pod kątem KodiBridge ID.\n\nPrzy dużej bibliotece na NAS operacja może potrwać od kilku do kilkunastu minut.\n\nNie należy wyłączać Kodi ani przerywać pracy do czasu pojawienia się kolejnego okna z podsumowaniem."

msgctxt "#32078"
msgid "Scanning library and NFO files. Please wait..."
msgstr "Skanowanie biblioteki i plików NFO. Proszę czekać..."

msgctxt "#32079"
msgid "KodiBridge ID assignment is already running in the background. Please wait for it to finish."
msgstr "Przypisywanie KodiBridge ID jest już wykonywane w tle. Poczekaj na zakończenie."

msgctxt "#32080"
msgid "Scanning library and checking KodiBridge IDs..."
msgstr "Skanowanie biblioteki i sprawdzanie KodiBridge ID..."

msgctxt "#32081"
msgid "Assigning KodiBridge IDs..."
msgstr "Przypisywanie KodiBridge ID..."

msgctxt "#32082"
msgid "This window will close automatically once the process completes."
msgstr "To okno zamknie się automatycznie po zakończeniu operacji."

msgctxt "#32083"
msgid "Operation was cancelled by the user."
msgstr "Operacja została anulowana przez użytkownika."


msgctxt "#32084"
msgid "Resolve conflicts"
msgstr "Rozwiąż konflikty"

msgctxt "#32085"
msgid "Shows changes made on two Kodi devices at the same time (e.g. different play counts) and lets you choose the correct value. Conflicts postponed with \"Later\" are asked about again."
msgstr "Pokazuje zmiany wprowadzone jednocześnie na dwóch Kodi (np. różna liczba odtworzeń) i pozwala wybrać właściwą wartość. Konflikty odłożone przyciskiem „Później” są pokazywane ponownie."

msgctxt "#32086"
msgid "Repair duplicate KodiBridge IDs"
msgstr "Napraw zdublowane KodiBridge ID"

msgctxt "#32087"
msgid "Gives new KodiBridge IDs to library items that share one KodiBridge ID. One item of each group keeps its ID. Changed .nfo files are backed up as .repair.bak; the change can be rolled back."
msgstr "Nadaje nowe KodiBridge ID pozycjom biblioteki, które mają to samo KodiBridge ID. Jedna pozycja z każdej grupy zachowuje swoje ID. Zmienione pliki .nfo dostają kopię .repair.bak; zmianę można wycofać."

msgctxt "#32100"
msgid "not checked"
msgstr "nie sprawdzano"

msgctxt "#32101"
msgid "Available on GitHub: {0} (checked: {1})"
msgstr "Dostępna na GitHub: {0} (sprawdzono: {1})"

msgctxt "#32102"
msgid "GitHub check error ({0}): {1}"
msgstr "Błąd sprawdzenia GitHub ({0}): {1}"

msgctxt "#32103"
msgid "No newer version (installed {0}, checked: {1})"
msgstr "Brak nowszej wersji (zainstalowana {0}, sprawdzono: {1})"

msgctxt "#32104"
msgid "Live synchronization: {state}\nPolling other Kodi devices: every {poll} s\nLast cycle: {when}\nLast received: {received}\nLast error: {error}"
msgstr "Synchronizacja bieżąca: {state}\nOdpytywanie innych Kodi: co {poll} s\nOstatni cykl: {when}\nOstatnio odebrano: {received}\nOstatni błąd: {error}"

msgctxt "#32105"
msgid "ON"
msgstr "WŁĄCZONA"

msgctxt "#32106"
msgid "OFF"
msgstr "WYŁĄCZONA"

msgctxt "#32107"
msgid "{0} items ({1})"
msgstr "{0} pozycji ({1})"

msgctxt "#32108"
msgid "none"
msgstr "brak"

msgctxt "#32109"
msgid "ON"
msgstr "WŁĄCZONE"

msgctxt "#32110"
msgid "OFF"
msgstr "WYŁĄCZONE"

msgctxt "#32111"
msgid "KodiBridge {version}\n\nDevice: {name}\nClient ID: {cid}\nKodi: {kodi} ({platform})\nJSON-RPC: {rpc}\nKodiBridge ID: {sid_state}\n{coverage}\n\nLast snapshot: {when}\nMovies: {movies}\nEpisodes: {episodes}\n\nSnapshot: {path}\n\n{live}\n\nUpdates: {update}"
msgstr "KodiBridge {version}\n\nUrządzenie: {name}\nClient ID: {cid}\nKodi: {kodi} ({platform})\nJSON-RPC: {rpc}\nKodiBridge ID: {sid_state}\n{coverage}\n\nOstatni snapshot: {when}\nFilmy: {movies}\nOdcinki: {episodes}\n\nSnapshot: {path}\n\n{live}\n\nAktualizacje: {update}"

msgctxt "#32112"
msgid "KodiBridge — status"
msgstr "KodiBridge — status"

msgctxt "#32113"
msgid "KodiBridge — update (GitHub)"
msgstr "KodiBridge — aktualizacja (GitHub)"

msgctxt "#32114"
msgid "Could not check for updates on GitHub Releases:\n{0}\n\nYou can install the update from a selected ZIP file instead."
msgstr "Nie udało się sprawdzić aktualizacji na GitHub Releases:\n{0}\n\nMożesz użyć opcji instalacji ze wskazanego pliku ZIP."

msgctxt "#32115"
msgid "You have the latest version available on GitHub Releases.\n\nInstalled: {0}"
msgstr "Masz najnowszą wersję dostępną w GitHub Releases.\n\nZainstalowana: {0}"

msgctxt "#32116"
msgid "KodiBridge — update available"
msgstr "KodiBridge — dostępna aktualizacja"

msgctxt "#32117"
msgid "A new version of KodiBridge, {0}, is available on GitHub Releases (installed: {1}).\n\nDownload and install the update now?"
msgstr "Na GitHub Releases dostępna jest nowa wersja KodiBridge {0} (obecnie zainstalowana: {1}).\n\nPobrać i zainstalować aktualizację teraz?"

msgctxt "#32118"
msgid "Install"
msgstr "Zainstaluj"

msgctxt "#32119"
msgid "Cancel"
msgstr "Anuluj"

msgctxt "#32120"
msgid "Select a KodiBridge update package (.zip)"
msgstr "Wybierz pakiet aktualizacji KodiBridge (.zip)"

msgctxt "#32121"
msgid "KodiBridge ID coverage: — (shown after the first synchronization cycle)"
msgstr "Pokrycie KodiBridge ID: — (pojawi się po pierwszym cyklu synchronizacji)"

msgctxt "#32122"
msgid "Synchronized items: — (shown after the first synchronization cycle)"
msgstr "Synchronizowane pozycje: — (pojawi się po pierwszym cyklu synchronizacji)"

msgctxt "#32123"
msgid "Synchronized (by external identifiers): movies {0}/{1}, episodes {2}/{3} (checked: {4})"
msgstr "Synchronizowane (według identyfikatorów zewnętrznych): filmy {0}/{1}, odcinki {2}/{3} (sprawdzono: {4})"

msgctxt "#32124"
msgid "Skipped, no external identifier: {0}"
msgstr "Pomijane, bo bez identyfikatora zewnętrznego: {0}"

msgctxt "#32125"
msgid "not synchronized (shared external identifier)"
msgstr "niesynchronizowane (wspólny identyfikator zewnętrzny)"

msgctxt "#32126"
msgid "same file twice in the library"
msgstr "ten sam plik dwa razy w bibliotece"

msgctxt "#32127"
msgid "unreadable .nfo: {0}"
msgstr "nieczytelne .nfo: {0}"

msgctxt "#32128"
msgid "To check:"
msgstr "Do sprawdzenia:"

msgctxt "#32129"
msgid "KodiBridge ID coverage: movies {0}/{1}, episodes {2}/{3} (checked: {4})"
msgstr "Pokrycie KodiBridge ID: filmy {0}/{1}, odcinki {2}/{3} (sprawdzono: {4})"

msgctxt "#32130"
msgid "without ID"
msgstr "bez ID"

msgctxt "#32131"
msgid "duplicate IDs"
msgstr "zdublowane ID"

msgctxt "#32132"
msgid "shared external IDs without KodiBridge ID"
msgstr "wspólne ID zewnętrzne bez KodiBridge ID"

msgctxt "#32133"
msgid "All items have a KodiBridge ID."
msgstr "Wszystkie pozycje mają KodiBridge ID."

msgctxt "#32134"
msgid "KodiBridge ID assignment is already running (e.g. after a library update). Wait for it to finish and try again."
msgstr "Nadawanie KodiBridge ID jest już wykonywane (np. po aktualizacji biblioteki). Poczekaj na jego zakończenie i spróbuj ponownie."

msgctxt "#32135"
msgid "The function is disabled. Enable it first and confirm the settings with OK."
msgstr "Funkcja jest wyłączona. Najpierw ją włącz i zatwierdź opcje przyciskiem OK."

msgctxt "#32136"
msgid "KodiBridge — duplicate IDs"
msgstr "KodiBridge — zdublowane ID"

msgctxt "#32137"
msgid "Library items that share one KodiBridge ID will get new KodiBridge IDs. One item of each group keeps its ID (the one synchronization knows). Changed .nfo files are backed up as .repair.bak and the change can be rolled back.\nReading the library may take a few minutes. Continue?"
msgstr "Pozycje biblioteki, które mają to samo KodiBridge ID, dostaną nowe KodiBridge ID. Jedna pozycja z każdej grupy zachowuje swoje ID (ta, którą zna synchronizacja). Zmienione pliki .nfo dostają kopię .repair.bak, a zmianę można wycofać.\nOdczyt biblioteki może potrwać kilka minut. Kontynuować?"

msgctxt "#32138"
msgid "Repair"
msgstr "Napraw"

msgctxt "#32139"
msgid "KodiBridge — duplicate ID repair"
msgstr "KodiBridge — naprawa zdublowanych ID"

msgctxt "#32140"
msgid "Assigning new IDs ({0}/{1})\n{2}"
msgstr "Nadaję nowe ID ({0}/{1})\n{2}"

msgctxt "#32141"
msgid "Reading the library and .nfo files…"
msgstr "Odczyt biblioteki i plików .nfo…"

msgctxt "#32142"
msgid "KodiBridge ID assignment is already running in the background. Wait for it to finish and try again."
msgstr "Przypisywanie KodiBridge ID jest już wykonywane w tle. Poczekaj na zakończenie i spróbuj ponownie."

msgctxt "#32143"
msgid "Same file twice in the library (this is not a duplicate ID):"
msgstr "Ten sam plik dwa razy w bibliotece (to nie jest zdublowane ID):"

msgctxt "#32144"
msgid "There are no duplicate KodiBridge IDs in the library of this Kodi."
msgstr "W bibliotece tego Kodi nie ma zdublowanych KodiBridge ID."

msgctxt "#32145"
msgid "Groups with the same ID: {0}. New IDs assigned: {1}. Skipped: {2}."
msgstr "Grupy z tym samym ID: {0}. Nadano nowe ID: {1}. Pominięte: {2}."

msgctxt "#32146"
msgid "Stopped on request; the remaining items are unchanged."
msgstr "Przerwano na żądanie; pozostałe pozycje bez zmian."

msgctxt "#32147"
msgid "Stopped: {0}"
msgstr "Przerwano: {0}"

msgctxt "#32148"
msgid "New IDs:"
msgstr "Nowe ID:"

msgctxt "#32149"
msgid "Kept their IDs:"
msgstr "Zachowały ID:"

msgctxt "#32150"
msgid "Skipped:"
msgstr "Pominięte:"

msgctxt "#32151"
msgid "Report: {0}. The change is undone with the “{1}” button."
msgstr "Raport: {0}. Zmianę wycofuje przycisk „{1}”."

msgctxt "#32152"
msgid "There is no saved operation to roll back."
msgstr "Brak zapisanej operacji do wycofania."

msgctxt "#32153"
msgid "Last KodiBridge ID assignment ({0})"
msgstr "Ostatnie przypisanie KodiBridge ID ({0})"

msgctxt "#32154"
msgid "Last duplicate ID repair ({0})"
msgstr "Ostatnia naprawa zdublowanych ID ({0})"

msgctxt "#32155"
msgid "Roll back the last KodiBridge ID assignment, restoring .nfo files from the backups?"
msgstr "Czy wycofać ostatnie przypisanie KodiBridge ID, przywracając pliki .nfo z kopii zapasowych?"

msgctxt "#32156"
msgid "Roll back the last duplicate ID repair, restoring .nfo files from the backups?"
msgstr "Czy wycofać ostatnią naprawę zdublowanych ID, przywracając pliki .nfo z kopii zapasowych?"

msgctxt "#32157"
msgid "KodiBridge — what to roll back?"
msgstr "KodiBridge — co wycofać?"

msgctxt "#32158"
msgid "KodiBridge — undo changes"
msgstr "KodiBridge — cofnięcie zmian"

msgctxt "#32159"
msgid "Yes, roll back"
msgstr "Tak, wycofaj"

msgctxt "#32160"
msgid "Restored: {0} files. Errors: {1}"
msgstr "Przywrócono: {0} plików. Błędy: {1}"

msgctxt "#32161"
msgid "Already rolled back earlier: {0}"
msgstr "Wycofane już wcześniej: {0}"

msgctxt "#32162"
msgid "Setup finished successfully. Everything is ready."
msgstr "Konfigurator zakończony pomyślnie. Środowisko gotowe."

msgctxt "#32163"
msgid "KodiBridge — update"
msgstr "KodiBridge — aktualizacja"

msgctxt "#32164"
msgid "No newer version on GitHub Releases."
msgstr "Brak nowszej wersji na GitHub Releases."

msgctxt "#32165"
msgid "Install version {0} from GitHub Releases?"
msgstr "Zainstalować wersję {0} z GitHub Releases?"

msgctxt "#32166"
msgid "Conflict check requested. Progress is shown in the corner of the screen; a large library takes a few minutes."
msgstr "Zlecono sprawdzenie konfliktów. Postęp w rogu ekranu; przy dużej bibliotece kilka minut."

msgctxt "#32167"
msgid "No new files needing an ID were found."
msgstr "Nie znaleziono żadnych nowych plików wymagających przypisania ID."

msgctxt "#32168"
msgid "KodiBridge — error"
msgstr "KodiBridge — błąd"

msgctxt "#32169"
msgid "Write error on the network share: {0}\nModified before the error: movies {1}, episodes {2}.\nDetails in kodi.log and in the report ({3})"
msgstr "Błąd zapisu na udziale sieciowym: {0}\nZmodyfikowano do błędu: filmy {1}, odcinki {2}.\nSzczegóły w kodi.log oraz w raporcie ({3})"

msgctxt "#32170"
msgid "Modified or created: movies: {0}, episodes: {1}.\nThe operation report was saved in the profile ({2})"
msgstr "Zmodyfikowano lub utworzono: filmy: {0}, odcinki: {1}.\nRaport z operacji zapisano w profilu ({2})"

msgctxt "#32200"
msgid "not synchronized (shared external identifier): {0}"
msgstr "niesynchronizowane (wspólny identyfikator zewnętrzny): {0}"

msgctxt "#32201"
msgid "same file twice in the library: {0}"
msgstr "ten sam plik dwa razy w bibliotece: {0}"

msgctxt "#32202"
msgid "unreadable .nfo: {0}"
msgstr "nieczytelne .nfo: {0}"

msgctxt "#32203"
msgid "Library items: {0}. Details in the KodiBridge status window."
msgstr "Pozycje biblioteki: {0}. Szczegóły w oknie statusu KodiBridge."

msgctxt "#32204"
msgid "without KodiBridge ID: {0}"
msgstr "bez KodiBridge ID: {0}"

msgctxt "#32205"
msgid "duplicate IDs: {0}"
msgstr "zdublowane ID: {0}"

msgctxt "#32206"
msgid "blocking synchronization: {0}"
msgstr "blokujące synchronizację: {0}"

msgctxt "#32207"
msgid "KodiBridge ID assignment stopped: {0}\nChanged before the error: movies {1}, episodes {2}."
msgstr "Nadawanie KodiBridge ID przerwane: {0}\nZmieniono do błędu: filmy {1}, odcinki {2}."

