msgstr ""
"Project-Id-Version: SudoSync\n"
"Language: pl_PL\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "#32000"
msgid "SudoSync"
msgstr "SudoSync"

msgctxt "#32001"
msgid "Connection"
msgstr "Połączenie"

msgctxt "#32002"
msgid "Synchronization folder"
msgstr "Folder synchronizacji"

msgctxt "#32003"
msgid "SMB folder shared by all Kodi installations."
msgstr "Folder SMB wspólny dla wszystkich instalacji Kodi."

msgctxt "#32004"
msgid "Device name"
msgstr "Nazwa urządzenia"

msgctxt "#32005"
msgid "Optional. If empty, Kodi friendly name is used."
msgstr "Opcjonalnie. Jeśli puste, używana jest przyjazna nazwa Kodi."

msgctxt "#32006"
msgid "Snapshot interval (seconds)"
msgstr "Interwał snapshotu (sekundy)"

msgctxt "#32007"
msgid "Collect-only mode periodically refreshes this device snapshot."
msgstr "Tryb zbierania okresowo odświeża snapshot tego urządzenia."

msgctxt "#32008"
msgid "Show notifications"
msgstr "Pokazuj powiadomienia o danych odebranych z innego Kodi"

msgctxt "#32010"
msgid "Tools"
msgstr "Narzędzia"

msgctxt "#32011"
msgid "Collect snapshot now"
msgstr "Zbierz snapshot teraz"

msgctxt "#32012"
msgid "Reads the local Kodi library and writes only this device file to NAS."
msgstr "Odczytuje lokalną bibliotekę Kodi i zapisuje na NAS tylko plik tego urządzenia."

msgctxt "#32013"
msgid "Show status"
msgstr "Pokaż status"

msgctxt "#32014"
msgid "Shows client ID, Kodi version and last local snapshot status."
msgstr "Pokazuje ID klienta, wersję Kodi i stan ostatniego snapshotu."

msgctxt "#32020"
msgid "Safety"
msgstr "Bezpieczeństwo"

msgctxt "#32021"
msgid "Collect-only mode"
msgstr "Tryb tylko zbierania"

msgctxt "#32022"
msgid "Version 0.1 requires this option. No Kodi library data is modified."
msgstr "Wersja 0.1 wymaga tej opcji. Żadne dane biblioteki Kodi nie są modyfikowane."

msgctxt "#32030"
msgid "Updates"
msgstr "Aktualizacje"

msgctxt "#32031"
msgid "Check for updates in .SudoSync at startup"
msgstr "Sprawdzaj aktualizacje w .SudoSync przy uruchomieniu"

msgctxt "#32032"
msgid "Looks for newer service.sudosync-*.zip packages in the shared synchronization folder."
msgstr "Szuka nowszych pakietów service.sudosync-*.zip we wspólnym folderze synchronizacji."

msgctxt "#32033"
msgid "Check for update now"
msgstr "Sprawdź i zainstaluj aktualizację"

msgctxt "#32034"
msgid "Checks the shared .SudoSync folder for a newer SudoSync ZIP package."
msgstr "Sprawdza .SudoSync i, jeśli jest nowsza wersja, pozwala zainstalować ją bez otwierania ukrytego folderu."

msgctxt "#32015"
msgid "Run DRY RUN analysis now"
msgstr "Uruchom analizę DRY RUN teraz"

msgctxt "#32016"
msgid "Compares all client snapshots and writes a report. It never modifies Kodi libraries."
msgstr "Porównuje snapshoty wszystkich klientów i zapisuje raport. Nigdy nie modyfikuje bibliotek Kodi."

msgctxt "#32035"
msgid "Install updates automatically"
msgstr "Automatycznie instaluj aktualizacje z .SudoSync"

msgctxt "#32036"
msgid "Installs a newer package directly from the shared hidden folder. The new code becomes fully active after Kodi restarts."
msgstr "Instaluje nowszy pakiet bezpośrednio z ukrytego folderu współdzielonego. Nowy kod staje się w pełni aktywny po ponownym uruchomieniu Kodi."

msgctxt "#32040"
msgid "Initial synchronization"
msgstr "Synchronizacja początkowa"

msgctxt "#32041"
msgid "Allow one-shot initial synchronization (modifies Kodi library)"
msgstr "Uzbrój jednorazową synchronizację początkową (10 min)"

msgctxt "#32042"
msgid "Safety interlock. It is switched off again after every attempt."
msgstr "Uzbraja zapis natychmiast, bez zamykania ustawień. Wygasa po 10 minutach i jest kasowany po każdej próbie."

msgctxt "#32043"
msgid "Apply initial synchronization to THIS Kodi"
msgstr "Zastosuj synchronizację początkową na TYM Kodi"

msgctxt "#32044"
msgid "Creates a backup, rebuilds DRY RUN and applies only the safe plan to this Kodi. Background writes remain disabled."
msgstr "Tworzy backup, ponawia DRY RUN i stosuje tylko bezpieczny plan początkowy. Synchronizacja bieżąca rusza dopiero po zakończeniu inicjalizacji wszystkich Kodi."

msgctxt "#32045"
msgid "This Kodi is the base device for the first synchronization"
msgstr "Ustaw TO Kodi jako urządzenie bazowe pierwszej synchronizacji"

msgctxt "#32046"
msgid "Available until initialization is completed. The device must have an explicit name. Selection is stored in the shared .SudoSync configuration."
msgstr "Jawnie wybiera to Kodi jako bazowe. Jeżeli inne urządzenie jest już bazowe, najpierw trzeba użyć „Wyczyść wybór urządzenia bazowego”."

msgctxt "#32047"
msgid "Clear base-device selection"
msgstr "Wyczyść wybór urządzenia bazowego"

msgctxt "#32048"
msgid "Allows choosing a different base Kodi before the first synchronization is completed."
msgstr "Usuwa bieżący wybór. Dopiero po tym można wskazać inne bazowe Kodi przed zakończeniem pierwszej synchronizacji."

msgctxt "#32050"
msgid "Live synchronization"
msgstr "Synchronizacja bieżąca"

msgctxt "#32051"
msgid "Enable live synchronization after initialization"
msgstr "Włącz synchronizację bieżącą po inicjalizacji"

msgctxt "#32052"
msgid "Automatically synchronizes watch state, resume and user ratings after the first synchronization is complete."
msgstr "Po zakończeniu pierwszej synchronizacji automatycznie synchronizuje obejrzenie, playcount, lastplayed, resume i oceny użytkownika."

msgctxt "#32053"
msgid "Peer polling interval (seconds)"
msgstr "Interwał sprawdzania innych Kodi (sekundy)"

msgctxt "#32054"
msgid "How often this Kodi checks other client snapshots when there is no local event."
msgstr "Jak często to Kodi sprawdza snapshoty pozostałych urządzeń, gdy lokalnie nic się nie wydarzyło."

msgctxt "#32055"
msgid "Synchronize now"
msgstr "Synchronizuj teraz"

msgctxt "#32056"
msgid "Runs one live synchronization cycle immediately and shows a final summary."
msgstr "Natychmiast uruchamia jeden cykl synchronizacji bieżącej i pokazuje końcowe podsumowanie."

msgctxt "#32060"
msgid "Private videos"
msgstr "Prywatne wideo"

msgctxt "#32061"
msgid "Enable SudoSync ID for local media without standard IDs"
msgstr "Włącz SudoSync ID dla lokalnych multimediów"

msgctxt "#32062"
msgid "Allows creating a custom ID for media not present in online databases."
msgstr "Pozwala tworzyć własne ID dla wideo niewystępujących w bazach online."

msgctxt "#32063"
msgid "Network Name / Prefix (leave empty for auto)"
msgstr "Nazwa sieci / Prefiks (ZMIENIAJ TYLKO NA BAZIE)"

msgctxt "#32064"
msgid "Friendly name for the network. The internal NFO ID is generated once and remains permanent even if you rename this."
msgstr "Przyjazna nazwa. Wewnętrzny identyfikator w plikach NFO jest generowany raz i pozostanie niezmienny mimo zmiany tej nazwy."

msgctxt "#32065"
msgid "Assign SudoSync IDs to all video items in the library"
msgstr "Przypisz SudoSync ID wszystkim pozycjom wideo w bibliotece"

msgctxt "#32066"
msgid "Injects SudoSync IDs to all items in Kodi library missing a standard ID."
msgstr "Zapisuje SudoSync ID w plikach nfo (tworząc je w razie braku) wszystkich pozycji biblioteki bez ID."
