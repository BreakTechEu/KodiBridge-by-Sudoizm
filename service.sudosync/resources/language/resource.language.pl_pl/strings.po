msgid "Migration finished successfully."
msgstr "Migracja zakończona sukcesem."

msgctxt "#32525"
msgid "KodiBridge — network setup"
msgstr "KodiBridge — konfigurator sieciowy"

msgctxt "#32526"
msgid "We will now set up a new KodiBridge synchronization environment for your network.\n\nDo you want to use the reliable 'KodiBridge ID' identifier by default for videos without standard IDs (IMDb/TMDb)?"
msgstr "Skonfigurujemy teraz nowe środowisko synchronizacji KodiBridge dla Twojej sieci.\n\nCzy chcesz domyślnie używać niezawodnego identyfikatora „KodiBridge ID” dla wideo pozbawionych standardowych ID (IMDb/TMDb)?"

msgctxt "#32527"
msgid "Yes (recommended)"
msgstr "Tak (zalecane)"

msgctxt "#32528"
msgid "No, use IMDb"
msgstr "Nie, użyj IMDb"

msgctxt "#32529"
msgid "Could not save the new configuration to SudoSync.cfg"
msgstr "Nie udało się zapisać nowej konfiguracji do SudoSync.cfg"

msgctxt "#32530"
msgid "Success"
msgstr "Sukces"

msgctxt "#32531"
msgid "The .KodiBridge environment is set up correctly!\nSynchronization can start now."
msgstr "Środowisko .KodiBridge skonfigurowane poprawnie!\nTeraz synchronizacja może się rozpocząć."

msgctxt "#32532"
