msgstr "Wykryto istniejącą instalację starszej wersji KodiBridge w wybranym folderze.\n\nTwoje dotychczasowe dane i identyfikatory zostaną zachowane. KodiBridge wyodrębni teraz ustawienia sieciowe do nowego pliku SudoSync.cfg."

msgctxt "#32521"
msgid "Error"
msgstr "Błąd"

msgctxt "#32522"
msgid "Could not save the migrated configuration to SudoSync.cfg"
msgstr "Nie udało się zapisać zmigrowanej konfiguracji do SudoSync.cfg"

msgctxt "#32523"
